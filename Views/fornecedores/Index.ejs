<%- include("../Partials/header") %>
    <%- include("../Partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Fornecedores</h1>
                    <p class="text-muted">
                        Lista de fornecedores cadastrados
                    </p>
                </div>
                <a href="/fornecedor/cadastro" class="btn btn-primary">
                    <i class="bi bi-person-plus"></i> Novo fornecedor
                </a>
            </div>
            <%- include("../Partials/sort-controls") %>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover
                              align-middle" data-sortable-table>
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Razão Social</th>
                                    <th>CNPJ</th>
                                    <th>Email</th>
                                    <th>Telefone</th>
                                    <th>Cidade</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% fornecedores.forEach(mostrar=> { %>
                                    <tr data-sort-name="<%= mostrar.razaosocial %>" data-sort-id="<%= mostrar.id %>">
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.razaosocial %>
                                        </td>
                                        <td>
                                            <%= mostrar.cnpj %>
                                        </td>
                                        <td>
                                            <%= mostrar.email %>
                                        </td>
                                        <td>
                                            <%= mostrar.telefone %>
                                        </td>
                                        <td>
                                            <%= mostrar.cidade %>
                                        </td>
                                        <td>
                                            <a class="btn btn-orange btn-sm"
                                                href="/fornecedor/editar/<%= mostrar.id%>"><i class="bi bi-pen"></i> Editar</a>
                                            <a class="btn btn-danger btn-sm" href="/fornecedor/excluir/<%= mostrar.id%>"
                                                onclick="return confirm('Deseja excluir este fornecedor?')"><i class="bi bi-trash2"></i> Excluir</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../Partials/footer") %>