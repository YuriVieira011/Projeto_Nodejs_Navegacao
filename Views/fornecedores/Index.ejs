<%- include("../partials/header") %>
    <%- include("../partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Fornecedores</h1>
                    <p class="text-muted">
                        Lista de fornecedores cadastrados
                    </p>
                </div>
                <a href="/fornecedor/cadastro" class="btn btn-primary">
                    + Novo fornecedor
                </a>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover
                              align-middle">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Razão Social</th>
                                    <th>CNPJ</th>
                                    <th>Email</th>
                                    <th>Telefone</th>
                                    <th>Cidade</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% fornecedores.forEach(mostrar=> { %>
                                    <tr>
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.razaosocial %>
                                        </td>
                                        <td>
                                            <%= mostrar.cnpj %>
                                        </td>
                                        <td>
                                            <%= mostrar.email %>
                                        </td>
                                        <td>
                                            <%= mostrar.telefone %>
                                        </td>
                                        <td>
                                            <%= mostrar.cidade %>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../partials/footer") %>