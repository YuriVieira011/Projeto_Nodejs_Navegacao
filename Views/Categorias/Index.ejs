<%- include("../Partials/header") %>
    <%- include("../Partials/nav") %>
        <div class="container mt-5">
            <div class="d-flex justify-content-between
                align-items-center mb-4">
                <div>
                    <h1>Categorias</h1>
                    <p class="text-muted">
                        Lista de categorias cadastradas
                    </p>
                </div>
                <a href="/categoria/cadastro" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Nova Categoria
                </a>
            </div>
            <%- include("../Partials/sort-controls") %>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover
                              align-middle" data-sortable-table>
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Nome</th>
                                    <th>Descrição</th>
                                    <th>Opções</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% categorias.forEach(mostrar=> { %>
                                    <tr data-sort-name="<%= mostrar.nome %>" data-sort-id="<%= mostrar.id %>">
                                        <td>
                                            <%= mostrar.id %>
                                        </td>
                                        <td>
                                            <%= mostrar.nome %>
                                        </td>
                                        <td>
                                            <%= mostrar.descricao %>
                                        </td>
                                        <td>
                                            <a class="btn btn-orange btn-sm"
                                                href="/categoria/editar/<%= mostrar.id%>"><i class="bi bi-pen"></i> Editar</a>
                                            <a class="btn btn-danger btn-sm" href="/categoria/excluir/<%= mostrar.id%>"
                                                onclick="return confirm('Deseja excluir esta categoria?')"><i class="bi bi-trash2"></i> Excluir</a>
                                        </td>
                                    </tr>
                                    <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../Partials/footer") %>