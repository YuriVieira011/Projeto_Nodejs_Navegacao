<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>CRUD.ejs</title>

    <!-- Bootstrap 5 CSS -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <!-- Bootstrap Icons -->
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <style>
      html {
        color-scheme: light;
      }
      html[data-bs-theme="dark"] {
        color-scheme: dark;
      }
      html[data-bs-theme="dark"] body {
        background-color: #121212;
      }
      html[data-bs-theme="dark"] .bg-light {
        background-color: var(--bs-tertiary-bg) !important;
      }
      html[data-bs-theme="dark"] .text-dark {
        color: var(--bs-body-color) !important;
      }
      .orange {
        background-color: rgb(255, 136, 0);
        color: white;
      }
      .btn-orange {
        background-color: rgb(255, 136, 0);
        color: white;
        transition: all 0.2s ease-in-out;
      }
      .btn-orange:hover {
        background-color: rgb(212, 113, 0);
        color: white;
        /* Adiciona suavidade na animação */
        transition: all 0.2s ease-in-out;
      }
      .accent {
        background-color: #7a36f8;
        color: white;
        /* Adiciona suavidade na animação */
        transition: all 0.2s ease-in-out;
      }
      /* Efeito ao passar o mouse */
      .accent:hover {
        background-color: #8848fd; /* Um tom de roxo um pouco mais escuro (opcional para dar destaque) */
        color: white;
        transform: scale(1.05); /* Aumenta o tamanho do botão em 5% */
      }
      /* Por padrão: mostra apenas o ícone outline e esconde o preenchido */
      .icon-hover .icon-filled {
        display: none;
      }
      .icon-hover .icon-outline {
        display: inline-block;
      }
      /* Ao passar o mouse (hover): esconde o outline e mostra o preenchido */
      .icon-hover:hover .icon-outline {
        display: none;
      }
      .icon-hover:hover .icon-filled {
        display: inline-block;
      }
      /* Efeito de elevação nos cards */
      .card-hover {
        transition: all 0.3s ease-in-out;
      }
      .card-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
      }
    </style>
    <script>
      document.documentElement.dataset.bsTheme =
        localStorage.getItem("theme") === "dark" ? "dark" : "light";
    </script>
  </head>

  <body></body>
</html>
